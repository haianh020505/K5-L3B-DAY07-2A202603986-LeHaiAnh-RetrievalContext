# Copy to starter/.env (or .env at repo root). Never commit the real file.
OPENROUTER_API_KEY=
# Agent + rerank run on Groq (free tier); "groq/" prefix routes to api.groq.com
GROQ_API_KEY=
CHAT_MODEL=groq/openai/gpt-oss-120b
# Bonus page transcription (vision) on Google AI Studio free tier
GEMINI_API_KEY=
VISION_MODEL=gemini/gemini-3.5-flash-lite
# Must match the Day 6 index (1536 dimensions)
EMBEDDING_MODEL=openai/text-embedding-3-small
# Day 6 Chroma folder; recreate it with `python -m src.run` in the Day 6 starter/
DAY6_CHROMA_PATH=../K5-L3B-DAY06-LeHaiAnh-2A202603986-DataIngestion/starter/chroma_db
